{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tablica Ofert",
  "mainBinaryName": "tablica-ofert",
  "version": "0.1.0",
  "identifier": "pl.prywatne.tablicaofert",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tablica Ofert",
        "width": 1360,
        "height": 820,
        "minWidth": 900,
        "minHeight": 560,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost ws://localhost:1420; object-src 'none'; base-uri 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Szymon Bakonis",
    "copyright": "MIT License",
    "category": "Productivity",
    "shortDescription": "Tablica Ofert - personal job search board",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Polish",
          "English"
        ],
        "customLanguageFiles": {
          "Polish": "windows/Polish.nsh"
        },
        "displayLanguageSelector": false,
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
