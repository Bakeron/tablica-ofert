# Dependencies and build output (recreated by npm install / cargo build)
node_modules/
dist/
dist-ssr/
src-tauri/target/
src-tauri/gen/schemas/

# Logs
*.log
npm-debug.log*

# Local files - never in the public repo (keys, real data, local settings)
*.local
.env
.env.*
*.db
*.db-journal
*.db-wal
*.pfx
*.jks
*.keystore
google-client.json

# Editors and system
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Claude Code - settings, skills, notes (a work tool, not part of the app)
.claude/
CLAUDE.local.md
# Every .md file except README - notes, plans, logs, CLAUDE.md stay only on the disk
*.md
!/README.md
# Privacy policy for the users - stays in the repository until the author decides
!/PRIVACY.md

# Signing keys, passwords, service accounts
*.keystore
*.jks
*.p12
*.pfx
*.pem
*.key
*.der
*.crt
HASLO*
*haslo*
*password*
*secret*
# App code with "secret" in the name, not secrets
!/src-tauri/src/secrets.rs
!/src/components/SecretField.tsx
google-services.json
GoogleService-Info.plist
*service-account*.json
*credentials*.json
client_secret*.json

# Memory dumps and repository copies
*.dmp
*.bundle
*.orig
*.bak

# Built phone installers (scripts/android-build.ps1)
/apk/
